{
  "name": "DamageReport",
  "type": "object",
  "properties": {
    "bus_number": {
      "type": "string",
      "description": "Bus identification number"
    },
    "driver_name": {
      "type": "string",
      "description": "Name of the driver reporting the damage"
    },
    "damage_location": {
      "type": "string",
      "enum": [
        "Front",
        "Rear",
        "Left Side",
        "Right Side",
        "Interior",
        "Roof",
        "Undercarriage",
        "Other"
      ],
      "description": "Location of the damage on the bus"
    },
    "damage_description": {
      "type": "string",
      "description": "Detailed description of the damage"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Minor",
        "Moderate",
        "Severe",
        "Critical"
      ],
      "description": "Severity level of the damage"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of damage photos"
    },
    "status": {
      "type": "string",
      "enum": [
        "Submitted",
        "Under Review",
        "In Repair",
        "Resolved"
      ],
      "default": "Submitted",
      "description": "Current status of the damage report"
    },
    "incident_date": {
      "type": "string",
      "format": "date",
      "description": "Date when the damage occurred"
    }
  },
  "required": [
    "bus_number",
    "damage_location",
    "damage_description"
  ]
}